{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kuibu.dev/schema/events.schema.json",
  "title": "Event",
  "description": "kuibu 用户状态事件日志（JSONL，每行一个 Event），按 type 区分 5 种事件",
  "oneOf": [
    { "$ref": "#/definitions/sessionStart" },
    { "$ref": "#/definitions/blockRead" },
    { "$ref": "#/definitions/answer" },
    { "$ref": "#/definitions/checkin" },
    { "$ref": "#/definitions/settingsChange" }
  ],
  "definitions": {
    "sessionStart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ts", "type", "book_id", "target_seconds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "ts": { "type": "string", "format": "date-time" },
        "type": { "const": "session_start" },
        "book_id": { "type": "string", "minLength": 1 },
        "target_seconds": { "type": "integer", "minimum": 1 }
      }
    },
    "blockRead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ts", "type", "block_id", "seconds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "ts": { "type": "string", "format": "date-time" },
        "type": { "const": "block_read" },
        "block_id": { "type": "string", "minLength": 1 },
        "seconds": { "type": "integer", "minimum": 0 }
      }
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ts", "type", "question_id", "correct"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "ts": { "type": "string", "format": "date-time" },
        "type": { "const": "answer" },
        "question_id": { "type": "string", "minLength": 1 },
        "correct": { "type": "boolean" }
      }
    },
    "checkin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ts", "type", "date"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "ts": { "type": "string", "format": "date-time" },
        "type": { "const": "checkin" },
        "date": {
          "type": "string",
          "format": "date",
          "description": "已按偏移自然日换算好的打卡日，不是 ts 的原始时间戳"
        }
      }
    },
    "settingsChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ts", "type", "key", "value"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "ts": { "type": "string", "format": "date-time" },
        "type": { "const": "settings_change" },
        "key": { "type": "string", "minLength": 1 },
        "value": {
          "description": "设置值，类型依 key 而定（如 daily_target_seconds 是 integer）",
          "oneOf": [
            { "type": "string" },
            { "type": "number" },
            { "type": "boolean" }
          ]
        }
      }
    }
  }
}
