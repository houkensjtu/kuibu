{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kuibu.dev/schema/pack.schema.json",
  "title": "ContentPack",
  "description": "kuibu 内容包：manifest + blocks + items + questions + exercises + recap_checkpoints + section_headings 的组合视图",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest", "blocks", "items", "questions", "exercises", "recap_checkpoints", "section_headings"],
  "properties": {
    "manifest": { "$ref": "#/definitions/manifest" },
    "blocks": {
      "type": "array",
      "items": { "$ref": "#/definitions/block" }
    },
    "items": {
      "type": "array",
      "items": { "$ref": "#/definitions/knowledgeItem" }
    },
    "questions": {
      "type": "array",
      "items": { "$ref": "#/definitions/question" }
    },
    "exercises": {
      "type": "array",
      "items": { "$ref": "#/definitions/exercise" }
    },
    "recap_checkpoints": {
      "type": "array",
      "items": { "$ref": "#/definitions/recapCheckpoint" }
    },
    "section_headings": {
      "type": "array",
      "items": { "$ref": "#/definitions/sectionHeading" }
    }
  },
  "definitions": {
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "book_id",
        "title",
        "author",
        "license",
        "source",
        "generated_at",
        "generator_version"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "description": "内容包遵循的 schema 版本，阅读器加载时据此校验"
        },
        "book_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "author": { "type": "string" },
        "license": { "type": "string" },
        "source": { "type": "string" },
        "generated_at": { "type": "string", "format": "date-time" },
        "generator_version": { "type": "string" }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "seq",
        "section_path",
        "section_title",
        "content_md",
        "est_seconds",
        "recap_md"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "seq": { "type": "integer", "minimum": 1 },
        "section_path": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "section_title": { "type": "string", "minLength": 1 },
        "content_md": { "type": "string" },
        "est_seconds": { "type": "integer", "minimum": 1 },
        "recap_md": { "type": "string" }
      }
    },
    "knowledgeItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "block_ids", "statement", "question_ids"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "block_ids": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "statement": { "type": "string", "minLength": 1 },
        "question_ids": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "item_id",
        "type",
        "prompt",
        "options",
        "answer_index",
        "explanation"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "item_id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["single_choice"] },
        "prompt": { "type": "string", "minLength": 1 },
        "options": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 2
        },
        "answer_index": { "type": "integer", "minimum": 0 },
        "explanation": { "type": "string" }
      }
    },
    "exercise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "block_id", "number", "prompt_md", "hint_md"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "block_id": {
          "type": "string",
          "minLength": 1,
          "description": "读完这个 block 之后，这道习题才会出现在当天的可选习题列表里"
        },
        "number": {
          "type": "string",
          "minLength": 1,
          "description": "原书自己的习题编号，如 \"1.9\"，纯展示用，不参与排序/调度"
        },
        "prompt_md": {
          "type": "string",
          "description": "习题原文，逐字从原书切出来，不是复述——跟 block.content_md 是同一条铁律"
        },
        "hint_md": {
          "type": "string",
          "description": "提示（不是答案）。当前阶段刻意不提供答案，只给一个不透题的提示"
        }
      }
    },
    "recapCheckpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "through_block_count", "recap_md"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "through_block_count": {
          "type": "integer",
          "minimum": 1,
          "description": "这条回顾覆盖了累计读到第几个 block（按 seq 计数，不是按天数）——运行时取 <= 用户实际已读 block 数里最大的那一条，不依赖任何每日阅读时长的假设"
        },
        "recap_md": {
          "type": "string",
          "description": "对累计读过的内容的回顾，构建期一次性写好，阅读器运行时只做查表，不重新生成"
        }
      }
    },
    "sectionHeading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "title"],
      "properties": {
        "path": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "description": "章/节这一级的路径，如 [\"1\"]（章）或 [\"1\",\"1.1\"]（节）——不是 block 的完整叶子路径"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "原书自己的章/节标题，机械从原文标题标签里提取，不是生成器编的"
        }
      }
    }
  }
}
