node_modules/
dist/

pack-gen/.venv/
__pycache__/
*.pyc
.pytest_cache/

# 每本书一个独立事件日志（DESIGN.md §14.4）：SICP 默认还是 .kuibu-events.jsonl，
# 其他 pack 默认按目录名推导，比如 .kuibu-events-gatsby.jsonl。
.kuibu-events*.jsonl

# build/sicp/sections 和 pack-parts 都是机械/确定性可重跑的中间产物；
# llm-output 不忽略——目前是手工产出（M3.22 还没接真实 API），之后接了 API
# 也是真金白银换来的结果，不该被 rm -rf build 之类操作误删。
pack-gen/build/sicp/sections/
pack-gen/build/sicp/pack-parts/
pack-gen/build/sicp/merged-pack-parts.json
pack-gen/build/sicp/recap-boundaries.json
pack-gen/build/gatsby/sections/
pack-gen/build/gatsby/pack-parts/
pack-gen/build/gatsby/merged-pack-parts.json
pack-gen/build/gatsby/recap-boundaries.json
pack-gen/.env

# 私有内容包（版权不允许公开分发的书）。见 CLAUDE.md/DESIGN.md §4.5：
# 这条必须先于任何私有包文件存在——.gitignore 对已 tracked 的文件无效。
packs-private/
packs/private/
pack-gen/build/xiyouji/sections/
pack-gen/build/xiyouji/pack-parts/
pack-gen/build/xiyouji/merged-pack-parts.json
pack-gen/build/xiyouji/recap-boundaries.json

# `npm run bundle` 的产物：单文件内容包，用来传到手机上导入网页版。私有书的
# bundle 是受版权保护原文的派生物，一行都不能进 git；公开书的 bundle 也是可
# 重跑的构建产物，没有进 git 的理由。两条规则：目录 + 后缀，后者是防"先把
# bundle 拷到桌面、又拷回仓库某处"这条绕过目录规则的路径。
bundles/
*.kuibu.json

# 私有书的 pack-gen 中间产物：跟上面公开书不同，这里整个目录树 wholesale
# 忽略（源文件 + sections/pack-parts/llm-output/merged 全部，包括 llm-output——
# 公开书的 llm-output 故意不忽略，因为是值得保护的手工产出；私有书恰恰相反，
# llm-output 本身就是从受版权保护原文派生的内容，一行都不能进 git）。
# 用两条 wholesale 规则而不是照抄公开书的逐本手动列 4 行，是为了让以后新增
# 任何私有书都不需要再碰 .gitignore。
pack-gen/sources/private/
pack-gen/build/private/
